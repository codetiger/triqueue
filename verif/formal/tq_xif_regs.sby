#
# Unbounded proof (k-induction) of the CV-X-IF register adapter, for any CPU that holds an
# offered issue until ready, and any register port (gnt free, response any number of cycles
# later): the register port is used only for a committed instruction with its operands, at
# most one instruction is open, a result only for an open one, results are held until taken,
# and the register-port request is held unchanged until gnt. Covers: a read and a write
# complete, a kill in the issue cycle, a commit before the operands.
# Run: sby -f tq_xif_regs.sby

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 12

[engines]
smtbmc yices

[script]
read_verilog -sv -formal tq_xif_regs.sv
prep -top tq_xif_regs

[files]
../../rtl/adapters/tq_xif_regs.sv
