# SPDX-FileCopyrightText: 2026 Harishankar Narayanan
# SPDX-License-Identifier: Apache-2.0 WITH SHL-2.1
#
# Formal proofs of the AXI4 memory master (tq_axi_mem, W = 4, 3 transactions in flight) for any
# core request sequence that keeps OBI rules but may drop a waiting request, and any in-order AXI
# slave (tq_axi_mem_env.sv): AXI VALID and payload held until READY, the core gets exactly its own
# responses in order with the right data, wr_done only for its writes, and the internal tag / slot
# / order FIFOs are never pushed when full or popped when empty.
#   prove        unbounded (ABC PDR), BURST_BEATS = 1, every property (~20 s)
#   cover        reachability: a dropped read and a dropped write complete, bus error, new epoch
#   burst        BMC depth 10, BURST_BEATS = 2, every property including read data (~40 s)
#   burst_prove  unbounded (ABC PDR), BURST_BEATS = 2, every property except the read-data
#                equality (CHECK_RDATA = 0, ~20 s). At MAX_OUT = 3 the data equality is not
#                inductive without strengthening invariants that tie the line slots and the order
#                FIFO to the environment's queues; PDR does not converge on it in hours.
#   burst_data   unbounded (ABC PDR), BURST_BEATS = 2, MAX_OUT = 1, every property including read
#                data (~5 min, nightly): one core read in flight, with the 4-slot line buffer,
#                hits, orphans, flush/epoch, write invalidation and error responses unrestricted.
#                MAX_OUT > 1 for read data is covered to the `burst` depth.
#   ids          BMC depth 10, BURST_BEATS = 2, LINES = 2, WR_IDS = 2 (ID_W = 2): an ID per line
#                slot and per write, a slave that answers the IDs in any order with interleaved
#                R beats; every property including read data
#   ids_prove    unbounded (ABC PDR), the same configuration, every property except the read-data
#                equality (as burst_prove)
#   ids_cover    reachability: R and B out of issue order reach the core
# Run: sby -f tq_axi_mem.sby <task>

[tasks]
prove
cover
burst
burst_prove
burst_data
ids
ids_prove
ids_cover

[options]
prove: mode prove
cover: mode cover
cover: depth 16
burst: mode bmc
burst: depth 10
burst_prove: mode prove
burst_data: mode prove
ids: mode bmc
ids: depth 10
ids_prove: mode prove
ids_cover: mode cover
ids_cover: depth 16

[engines]
prove: abc pdr
cover: smtbmc yices
burst: smtbmc yices
burst_prove: abc pdr
burst_data: abc pdr
ids: smtbmc yices
ids_prove: abc pdr
ids_cover: smtbmc yices

[script]
# TQ_FORMAL_CORE: the embedded FIFOs assert their legal use (as in tq_core.sby) instead of loading
# tq_fifo's stand-alone proof, whose environment assumptions would constrain the adapter under test
# and bound every trace to fewer than 28 pushes per FIFO. tq_fifo.sby proves the FIFO itself.
read_verilog -sv -formal -DTQ_FORMAL_CORE tq_icg.sv tq_cg.sv tq_fifo.sv tq_axi_mem.sv tq_axi_mem_env.sv
burst: chparam -set BURST_BEATS 2 tq_axi_mem_env
burst_prove: chparam -set BURST_BEATS 2 -set CHECK_RDATA 0 tq_axi_mem_env
burst_data: chparam -set BURST_BEATS 2 -set MAX_OUT 1 tq_axi_mem_env
ids: chparam -set BURST_BEATS 2 -set LINES 2 -set WR_IDS 2 tq_axi_mem_env
ids_prove: chparam -set BURST_BEATS 2 -set LINES 2 -set WR_IDS 2 -set CHECK_RDATA 0 tq_axi_mem_env
ids_cover: chparam -set BURST_BEATS 2 -set LINES 2 -set WR_IDS 2 tq_axi_mem_env
prep -top tq_axi_mem_env
flatten
opt_clean
# out-of-range part-select fill (x) becomes a free value, so the abc engine can take the model
techmap t:$shiftx
setundef -anyseq

[files]
../../rtl/common/tq_icg.sv
../../rtl/common/tq_cg.sv
../../rtl/common/tq_fifo.sv
../../rtl/adapters/tq_axi_mem.sv
tq_axi_mem_env.sv
