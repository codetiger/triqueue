#
# Unbounded proof (k-induction) of the AXI4-Lite register adapter, for any master that keeps
# the AXI handshake rules, and any register port (gnt free, read data any number of cycles
# later): responses stay valid until taken, R data is stable, AW and W are accepted together,
# exactly one response per request with one transaction open at a time, and the register-port
# request is held unchanged until gnt; covers show both kinds complete, also after a held request.
# Run: sby -f tq_axil_regs.sby

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 12

[engines]
smtbmc yices

[script]
read_verilog -sv -formal tq_axil_regs.sv
prep -top tq_axil_regs

[files]
../../rtl/adapters/tq_axil_regs.sv
